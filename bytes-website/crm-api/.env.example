# OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

FACEBOOK_CLIENT_ID=your_facebook_client_id
FACEBOOK_CLIENT_SECRET=your_facebook_client_secret

LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

# Redirect URLs
AUTH_REDIRECT_URL=http://localhost:4000/api/auth/{{provider}}/callback
FRONTEND_ONBOARDING_URL=http://localhost:5173/onboarding/

# API Keys
GEMINI_API_KEY=your_gemini_api_key

# Admin secret — a strong random string used to authenticate dashboard logins
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=your_strong_random_admin_secret

# OAuth state signing secret — prevents CSRF on OAuth flows
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OAUTH_STATE_SECRET=your_strong_random_oauth_secret

# Absolute path to the SQLite database file
# DB_PATH=/absolute/path/to/your/database.sqlite

# Allowed origins for CORS (comma-separated)
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
